{
  "name": "pnd-v2",
  "private": true,
  "packageManager": "pnpm@9.14.2",
  "scripts": {
    "dev:web": "pnpm --filter @pin/web dev",
    "dev:indexer": "pnpm --filter @pin/indexer dev",
    "dev:worker": "pnpm --filter @pin/worker dev",
    "dev:editions": "echo 'dev:editions is superseded by dev:collections (DeployEditions.s.sol was removed; scripts/dev-editions.sh is kept for reference only). Run: pnpm dev:collections' && exit 1",
    "dev:collections": "bash scripts/dev-collections.sh",
    "build": "pnpm --filter @pin/web build",
    "build:artist-template": "pnpm --filter sovereign-artist-site build",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r typecheck",
    "db:migrate": "node --env-file=.env db/migrate.mjs",
    "indexer:switch": "node --env-file=.env scripts/switch-indexer-schema.mjs",
    "worker:cost": "node --env-file=.env scripts/check-worker-cost.mjs",
    "worker:refresh": "node --env-file=.env scripts/worker-refresh.mjs",
    "agent:context": "node scripts/agent-context.mjs",
    "agent:check": "node scripts/check-program-state.mjs",
    "agent:overlap": "node scripts/check-program-overlap.mjs",
    "emit:surface-abi": "node scripts/emit-surface-abi.mjs",
    "generate:docs": "tsx scripts/generate-docs.ts"
  },
  "devDependencies": {
    "marked": "^18.0.5",
    "postgres": "^3.4.9",
    "shiki": "^4.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0"
  },
  "pnpm": {
    "overrides": {
      "qr": "0.5.5",
      "@hono/node-server": "1.19.15",
      "axios": "1.18.0",
      "brace-expansion": "2.1.4",
      "fast-uri": "3.1.6",
      "form-data": "4.0.6",
      "hono": "4.12.34",
      "nanoid": "3.3.18",
      "postcss": "8.5.26",
      "socket.io-parser": "4.2.7",
      "ua-parser-js": "2.0.10",
      "ws": "8.21.0"
    }
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  }
}
