{
  "name": "@pin/worker",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env --experimental-strip-types --no-warnings src/index.ts",
    "start": "node --env-file-if-exists=.env --experimental-strip-types --no-warnings src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/capture/*.test.ts",
    "capture:thumbnails": "node --env-file-if-exists=.env --experimental-strip-types --no-warnings src/cli/capture-thumbnails.ts"
  },
  "dependencies": {
    "@irys/upload": "0.0.15",
    "@irys/upload-ethereum": "0.0.16",
    "@pin/abi": "workspace:*",
    "@pin/addresses": "workspace:*",
    "@pin/shared": "workspace:*",
    "@pin/token-metadata": "workspace:*",
    "playwright": "1.49.0",
    "postgres": "^3.4.9",
    "sharp": "^0.35.3",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
