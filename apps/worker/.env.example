# Required
DATABASE_URL=postgres://postgres:dev@localhost:5432/postgres

# Paid Alchemy is the right call for worker scans — volume bounded by
# known_artists × cadence, not by user traffic.
ALCHEMY_API_KEY=
# Or set the full URL explicitly:
# ALCHEMY_MAINNET_URL=https://eth-mainnet.g.alchemy.com/v2/...

# Etherscan API key (Manifold scanner needs txlist)
ETHERSCAN_API_KEY=

# Auth for POST /jobs/refresh-artist — must match web app's WORKER_SECRET
REVALIDATE_SECRET=

# Tuning
WARMER_BATCH_SIZE=50
WARMER_CONCURRENCY=4
WARMER_RETRY_AFTER=7 days

# Server port (Railway assigns automatically)
PORT=8080

# Surface thumbnail capture tool (apps/worker/src/cli/capture-thumbnails.ts).
# Not used by the worker's normal scan/serve process.
CAPTURE_CHAIN=sepolia
CAPTURE_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
CAPTURE_COLLECTION=0x0000000000000000000000000000000000000000
CAPTURE_RENDER_ASSETS=0x0000000000000000000000000000000000000000
CAPTURE_FRAME_BASE_URL=http://localhost:8793
CAPTURE_COVER_PATH=./cover.png
CAPTURE_IRYS_NETWORK=devnet
# Defaults to apps/worker/capture-out when unset.
CAPTURE_OUT_DIR=capture-out

# Signs and uploads Irys data items, and broadcasts setCaptureTemplate /
# notifyMetadataUpdate. Required outside --dry-run and for the `fund`
# subcommand. Never commit a real value.
CAPTURER_PK=
