# Required
DATABASE_URL=postgres://postgres:dev@localhost:5432/postgres

# Stable database views managed by scripts/switch-indexer-schema.mjs.
INDEXER_SCHEMA=indexer_live

# Paid Alchemy is the right call for worker scans — volume bounded by
# known_artists × cadence, not by user traffic.
ALCHEMY_API_KEY=
# Or set the full URL explicitly:
# ALCHEMY_MAINNET_URL=https://eth-mainnet.g.alchemy.com/v2/...

# Etherscan API key (Manifold scanner needs txlist)
ETHERSCAN_API_KEY=

# Auth for POST /jobs/refresh-artist — must match web app's WORKER_SECRET
REVALIDATE_SECRET=

# Tuning
WARMER_BATCH_SIZE=50
WARMER_CONCURRENCY=4
WARMER_RETRY_AFTER=7 days
# Used only when an RPC does not support Ethereum's `finalized` block tag.
FINALITY_CONFIRMATIONS=64

# External token-media delivery cache. Cloudflare R2's S3 endpoint is the
# intended low-cost default; any path-style S3-compatible store works.
# Leave every MEDIA_OBJECT_* variable unset to disable derivative generation.
# MEDIA_OBJECT_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# MEDIA_OBJECT_BUCKET=pnd-media
# MEDIA_OBJECT_PUBLIC_BASE_URL=https://media.example.com
# MEDIA_OBJECT_ACCESS_KEY_ID=
# MEDIA_OBJECT_SECRET_ACCESS_KEY=
MEDIA_OBJECT_REGION=auto
MEDIA_OBJECT_PREFIX=media-cache/v1
MEDIA_DERIVE_BATCH_SIZE=12
MEDIA_DERIVE_MAX_ATTEMPTS=4
MEDIA_DERIVE_MAX_INPUT_BYTES=26214400
MEDIA_DERIVE_MAX_PIXELS=60000000
MEDIA_DERIVE_WIDTH=800

# Server port (Railway assigns automatically)
PORT=8080
