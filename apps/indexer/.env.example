# Required
DATABASE_URL=postgres://postgres:dev@localhost:5432/postgres
DATABASE_SCHEMA=ponder_v1

# drpc.org free tier handles Ponder's factory-pattern multi-address
# eth_getLogs correctly. publicnode / llamarpc / ankr / Alchemy do not
# (or burn CU; see ../README.md "RPC strategy").
PONDER_RPC_URL_1=https://eth.drpc.org

# SovereignAuctionHouseV2Factory subscription. Both vars must be set for
# the indexer to wire up V2 handlers (see SOVEREIGN_V2_WIRED in
# ponder.config.ts). Mainnet factory, deployed at block 25901772.
SOVEREIGN_V2_FACTORY_ADDRESS=0x77aB853543286C9Cdd7dd6c01222A7cC4Ac93d63
SOVEREIGN_V2_FACTORY_START_BLOCK=25901772
