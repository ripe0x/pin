# Sepolia deploy target. Values only, no secrets; sourced by script/deploy.sh.

CHAIN_ID=11155111
FOUNDRY_PROFILE=default
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
VERIFY=1
REQUIRE_MAIN_BRANCH=0
WALLET_MODE=keystore

DEPLOYER=0xCB43078C32423F5348Cab5885911C3B5faE217F9

# Reuses the Catalog already deployed to sepolia (see deployments.sepolia.json).
CATALOG=0x6F0441B2f096d4db71C322F700dCeF0E88CFCcBC

# Empty: sepolia has no RenderAssets/DefaultRenderer deployment on record yet
# (deployments.sepolia.json leaves both blank); the script deploys fresh.
RENDER_ASSETS=
DEFAULT_RENDERER=

LAND_PAUSED=true
