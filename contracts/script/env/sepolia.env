# Sepolia deploy target. Values only, no secrets; sourced by script/deploy.sh.

CHAIN_ID=11155111
FOUNDRY_PROFILE=default
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
VERIFY=1
REQUIRE_MAIN_BRANCH=0
WALLET_MODE=keystore

DEPLOYER=0xCB43078C32423F5348Cab5885911C3B5faE217F9

# PND's referral address that the launcher copies into each sale it makes
# (paid by mint(quantity)). The same address pnd.fyi passes as referrer today
# (NEXT_PUBLIC_PND_REFERRAL_ADDRESS in netlify.toml); an EOA on both chains.
DEFAULT_REFERRER=0xea194A186EBe76A84E2B2027f5f23F81939c05AD

LAND_PAUSED=true
