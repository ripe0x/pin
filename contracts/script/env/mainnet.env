# Mainnet deploy target. Values only, no secrets; sourced by script/deploy.sh.
#
# DEPLOYER and CATALOG ship empty on purpose: script/deploy.sh refuses to run,
# DRY_RUN included, until both are filled in. The catalog public good is
# already live at 0x467a9c39e03C595EC3075D856f19C7386b6b915d (see
# deployments.mainnet.json); fill it in here once reuse on the v2 factory is
# confirmed, alongside the deployer address.

CHAIN_ID=1
FOUNDRY_PROFILE=default
RPC_URL=https://ethereum-rpc.publicnode.com
VERIFY=1
REQUIRE_MAIN_BRANCH=1
WALLET_MODE=keystore

DEPLOYER=
CATALOG=

# Empty: no RenderAssets/DefaultRenderer deployment exists on mainnet yet
# (deployments.mainnet.json leaves both blank); the script deploys fresh.
RENDER_ASSETS=
DEFAULT_RENDERER=

LAND_PAUSED=true
