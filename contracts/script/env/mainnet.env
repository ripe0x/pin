# Mainnet deploy target. Values only, no secrets; sourced by script/deploy.sh.
#
# DeploySurfaceV2.s.sol also asserts the ripe0x deployer on chain id 1.

CHAIN_ID=1
FOUNDRY_PROFILE=default
RPC_URL=https://mainnet.gateway.tenderly.co
VERIFY=1
REQUIRE_MAIN_BRANCH=1
WALLET_MODE=keystore

DEPLOYER=0xCB43078C32423F5348Cab5885911C3B5faE217F9

# PND's referral address that the launcher copies into each sale it makes
# (paid by mint(quantity)). Every sale keeps its copy for good, so this key
# must stay recoverable. The same EOA pnd.fyi passes as referrer today
# (NEXT_PUBLIC_PND_REFERRAL_ADDRESS in netlify.toml) and Sepolia uses.
DEFAULT_REFERRER=0xea194A186EBe76A84E2B2027f5f23F81939c05AD

LAND_PAUSED=true
