# Mainnet deploy target. Values only, no secrets; sourced by script/deploy.sh.
#
# DEPLOYER ships empty on purpose: script/deploy.sh refuses to run, DRY_RUN
# included, until it is filled in. DeploySurfaceV2.s.sol additionally
# asserts the ripe0x deployer on chain id 1.

CHAIN_ID=1
FOUNDRY_PROFILE=default
RPC_URL=https://ethereum-rpc.publicnode.com
VERIFY=1
REQUIRE_MAIN_BRANCH=1
WALLET_MODE=keystore

DEPLOYER=

# PND's referral address that the launcher copies into each sale it makes
# (paid by mint(quantity)). Ships empty on purpose, like DEPLOYER: the
# wrapper and the script both refuse a mainnet run until it is set. Use a
# Safe or splitter, never a personal wallet: every sale keeps its copy.
DEFAULT_REFERRER=

LAND_PAUSED=true
