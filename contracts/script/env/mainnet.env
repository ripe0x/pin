# Mainnet deploy target. Values only, no secrets; sourced by script/deploy.sh.
#
# DEPLOYER ships empty on purpose: script/deploy.sh refuses to run, DRY_RUN
# included, until it is filled in. CATALOG is filled in already: it is the
# Surface protocol's public good, the same address on every chain (see
# deployments.mainnet.json), and DeploySurfaceV2.s.sol asserts this exact
# value on chain id 1.

CHAIN_ID=1
FOUNDRY_PROFILE=default
RPC_URL=https://ethereum-rpc.publicnode.com
VERIFY=1
REQUIRE_MAIN_BRANCH=1
WALLET_MODE=keystore

DEPLOYER=
CATALOG=0x467a9c39e03C595EC3075D856f19C7386b6b915d

# Empty: no RenderAssets/DefaultRenderer deployment exists on mainnet yet
# (deployments.mainnet.json leaves both blank); the script deploys fresh.
RENDER_ASSETS=
DEFAULT_RENDERER=

LAND_PAUSED=true
