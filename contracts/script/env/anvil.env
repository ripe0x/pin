# Local Anvil deploy target. Values only; sourced by script/deploy.sh.

CHAIN_ID=31337
FOUNDRY_PROFILE=default
RPC_URL=http://127.0.0.1:8545
VERIFY=0
REQUIRE_MAIN_BRANCH=0
WALLET_MODE=anvil

# Anvil's default account 0. --unlocked lets anvil sign for it with no key.
DEPLOYER=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266

# Empty: the script deploys a fresh Catalog/RenderAssets/DefaultRenderer on
# any chain id other than mainnet and sepolia. Set to reuse an existing one.
CATALOG=
RENDER_ASSETS=
DEFAULT_RENDERER=

LAND_PAUSED=true
