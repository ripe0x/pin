{
  "name": "sovereign-artist-site",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted auction page for an artist's SovereignAuctionHouse. Deploy to Vercel or Netlify.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "@pin/abi": "workspace:*",
    "@pin/surface-react": "workspace:*",
    "@pin/surface-kit": "workspace:*",
    "@rainbow-me/rainbowkit": "2.2.11",
    "@tanstack/react-query": "5.102.3",
    "next": "15.5.24",
    "next-themes": "0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "viem": "2.55.19",
    "wagmi": "2.19.5",
    "zero-deps-zorbs": "^0.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.6",
    "@netlify/plugin-nextjs": "5.15.13",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.24",
    "postcss": "8.5.26",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "overrides": {
    "@walletconnect/ethereum-provider": "2.23.10",
    "axios": "1.19.0",
    "postcss": "$postcss"
  }
}
